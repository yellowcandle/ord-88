        {
          "type": "text",
          "id": "f8QXS",
          "x": 452,
          "y": 116,
          "name": "Deck EN",
          "fill": "$s-ink2",
          "textGrowth": "fixed-width",
          "width": 420,
          "content": "Every society on the register resolves into one of seventeen purposes. The religious fourth resolves again, into eleven traditions and thirteen Protestant denominations. Band height is the number of societies — never a share of a share.",
          "lineHeight": 1.55,
          "fontFamily": "$s-body",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Yvqo1",
          "x": 900,
          "y": 116,
          "name": "Deck ZH",
          "fill": "$s-ink2",
          "textGrowth": "fixed-width",
          "width": 560,
          "content": "登記冊上的每一間社團，最終都歸入十七個用途之一。「宗教」再分為十一個信仰傳統，其中基督新教再分為十三個教派。色帶的高度就是社團數目，不是比例。",
          "lineHeight": 1.7,
          "fontFamily": "$s-body",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "TngXE",
